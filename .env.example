# =============================================================================
# VCF Analysis Agent — environment configuration template
# Copy to `.env` and fill in real values.
# =============================================================================

# ---- Z.AI (GLM) — default model provider -----------------------------------
# Coding Plan key works through a dedicated endpoint:
#   OpenAI-compatible:  https://api.z.ai/api/coding/paas/v4
#   Anthropic-style:    https://api.z.ai/api/anthropic
ZAI_API_KEY=your-zai-coding-plan-key
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
# Model id WITHOUT the litellm "zai/" prefix; prefix is added in code.
# Available on Coding Plan: glm-5, glm-5-turbo, glm-5.1, glm-5.2 (default).
ZAI_MODEL_ID=glm-5.2

# ---- Embeddings (LOCAL, independent from the chat LLM) ---------------------
# Embeddings are served by a local OpenAI-compatible server (LM Studio / vLLM /
# Ollama). This is decoupled from the chat model above: GLM-5.2 powers the agent,
# bge-m3 powers similarity search over variants.
# Default points to a locally running LM Studio on port 1234.
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-bge-m3
# Must match the served model's vector size and the LanceDB schema Vector(N).
EMBEDDING_DIM=1024

# ---- Alternative chat providers (optional) ---------------------------------
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# ---- Ollama (local, not used by default) -----------------------------------
# OLLAMA_HOST=http://localhost:11434

# ---- Agent behaviour -------------------------------------------------------
# VCF_AGENT_RAW_MODE=1   # set to 1/true/yes to disable chain-of-thought
